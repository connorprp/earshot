{
  "name": "earshot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node --env-file-if-exists=server/.env server/index.js",
    "dashboard": "npm run dev --prefix dashboard",
    "capture": "capture\\.venv\\Scripts\\python.exe capture\\main.py",
    "dev": "concurrently -n hub,ui,ear -c blue,magenta,yellow \"npm run server\" \"npm run dashboard\" \"npm run capture\"",
    "inject": "node scripts/inject.js"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "ws": "^8.18.0"
  }
}
