# Copy to deploy/.env and fill in. NEVER commit the real file.
EARSHOT_MONGO=mongodb+srv://...           # same Atlas cluster as dev
GOOGLE_CLIENT_ID=....apps.googleusercontent.com

ALEX_EMAIL=alex@example.com

# openssl rand -hex 32 (or any long random string), unique per user
SECRET_CONNOR=
SECRET_ALEX=
CAPTURE_KEY_CONNOR=
CAPTURE_KEY_ALEX=

# from `claude setup-token` (each user's own Claude subscription;
# Alex's can be yours initially and swapped later)
CLAUDE_TOKEN_CONNOR=
CLAUDE_TOKEN_ALEX=
