# Copy to deploy/.env and fill in. NEVER commit the real file.
EARSHOT_MONGO=mongodb+srv://...           # same Atlas cluster as dev
GOOGLE_CLIENT_ID=....apps.googleusercontent.com

# self-serve sign-in: any verified Google account under these domains gets a
# tenant automatically; ALLOWED_EMAILS adds specific outside accounts
ALLOWED_DOMAINS=example.com
ALLOWED_EMAILS=

# OPTIONAL: pre-seeded capture keys / Claude tokens ("email:value,...") —
# normally users get a key automatically and paste their own Claude token in
# the dashboard's Settings panel
CAPTURE_KEYS=
CLAUDE_TOKENS=
CLAUDE_TOKEN_FALLBACK=

# openssl rand -hex 32 (cookie signing)
SECRET=
