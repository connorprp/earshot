# Copy to deploy/.env and fill in. NEVER commit the real file.
EARSHOT_MONGO=mongodb+srv://...           # same Atlas cluster as dev
GOOGLE_CLIENT_ID=....apps.googleusercontent.com

ALLOWED_EMAILS=you@example.com,coworker@example.com

# openssl rand -hex 32 for each key; one per user
CAPTURE_KEYS=you@example.com:KEY1,coworker@example.com:KEY2

# per-user tokens from `claude setup-token` (distills bill each user's own
# subscription); leave a user out to fall back to CLAUDE_TOKEN_FALLBACK
CLAUDE_TOKENS=you@example.com:sk-ant-oat-...
CLAUDE_TOKEN_FALLBACK=

# openssl rand -hex 32 (cookie signing)
SECRET=
